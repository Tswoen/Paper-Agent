        "2506.22517v1",\n        "10.48550/arXiv.2004.10934",\n        "10.48550/arXiv.2108.07772",\n        "10.48550/arXiv.2204.02696",\n        "10.48550/arXiv.2304.09869",\n        "10.48550/arXiv.2506.22517v1"\n      ]\n    }\n  ],\n  "已调用工具得到的资料": [\n    {\n      "tool": "get_extraction",\n      "arguments": {\n        "paperIds": [\n          "10.3390/s19030664",\n          "10.3390/jimaging9100193"\n        ]\n      },\n      "result": [\n        {\n          "paperId": "10.3390/s19030664",\n          "status": "missing",\n          "extraction": {},\n          "source": ""\n        },\n        {\n          "paperId": "10.3390/jimaging9100193",\n          "status": "missing",\n          "extraction": {},\n          "source": ""\n        }\n      ]\n    },\n    {\n      "tool": "get_extraction",\n      "arguments": {\n        "paperIds": [\n          "10.3390/s19030664",\n          "10.3390/jimaging9100193"\n        ]\n      },\n      "result": [\n        {\n          "paperId": "10.3390/s19030664",\n          "status": "missing",\n          "extraction": {},\n          "source": ""\n        },\n        {\n          "paperId": "10.3390/jimaging9100193",\n          "status": "missing",\n          "extraction": {},\n          "source": ""\n        }\n      ]\n    },\n    {\n      "tool": "get_extraction",\n      "arguments": {\n        "paperIds": [\n          "10.3390/s19030664",\n          "10.3390/jimaging9100193"\n        ]\n      },\n      "result": [\n        {\n          "paperId": "10.3390/s19030664",\n          "status": "missing",\n          "extraction": {},\n          "source": ""\n        },\n        {\n          "paperId": "10.3390/jimaging9100193",\n          "status": "missing",\n          "extraction": {},\n          "source": ""\n        }\n      ]\n    }\n  ],\n  "当前草稿": "",\n  "审查整改建议": [],\n  "可用工具": [\n    "get_extraction(List[paperId])：获取论文结构化摘要",\n    "search_section(List[{paperId, List[chunkId]}])：按 chunkId 获取论文原文片段",\n    "get_chunk_by